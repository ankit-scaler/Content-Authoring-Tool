# ==============================================================================
# SCALER AI LECTURE SCRIPT GENERATOR - ENVIRONMENT CONFIGURATION
# ==============================================================================

# LLM Provider Selection: "claude" or "groq"
LLM_PROVIDER=claude

# Anthropic Claude Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_FAST_MODEL=claude-3-5-haiku-latest

# Groq Configuration (alternative fast provider)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini (Optional)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter (Optional)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Execution Mode: "live" (calls real APIs) or "mock" (offline test data)
EXECUTION_MODE=live

# Database Configuration (Default SQLite in backend directory)
DATABASE_URL=sqlite:///./scripts.db

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Export integrations
HACKMD_API_TOKEN=your_hackmd_api_token_here
